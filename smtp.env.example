# Copy to smtp.env on the institution server. Never commit smtp.env.
# Webmail login: https://webmail.saricam.bel.tr
# The webmail URL does not establish the SMTP host, port or account details.
# Obtain these settings from the municipality IT/mail administrator.
SMTP_ENABLED=0
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Port 587 requires STARTTLS; port 465 uses TLS from connection start.
# Set SMTP_ENABLED=1 only after completing the account settings.
